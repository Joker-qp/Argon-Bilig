models/*.onnx
!models/.gitkeep

# --- Streamlit Önbellek & Gizli Anahtarlar ---
.streamlit/secrets.toml

# --- Eski Proje Kalıntıları (Node.js & Svelte/Vite) ---
node_modules/
dist/
.pnpm-store/
.npm/

# --- Test, Önbellek ve Geçici Dosyalar ---
.cache/
.pytest_cache/
*.log
*.tmp
*.temp

